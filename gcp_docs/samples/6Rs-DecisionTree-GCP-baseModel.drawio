yle;rounded=0;jumpStyle=arc;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1;fontStyle=1;fontSize=13;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="OZ9AxooTVeGa2e1UKhC_-1" edge="1" source="gc-q-time" target="PnaUjTbA2eYcw9_eckQJ-7"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="gc-lbl-eliminate" value="Eliminate&lt;br&gt;(low value + low health)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontStyle=1;fontSize=12;labelBackgroundColor=#ffffff;" parent="OZ9AxooTVeGa2e1UKhC_-1" vertex="1"><mxGeometry x="560" y="-680" width="170" height="40" as="geometry" /></mxCell><mxCell id="gc-lbl-tolerate" value="Tolerate&lt;br&gt;(low/med value + high health,&lt;br&gt;no hard DC exit)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontStyle=1;fontSize=12;labelBackgroundColor=#ffffff;" parent="OZ9AxooTVeGa2e1UKhC_-1" vertex="1"><mxGeometry x="1000" y="-690" width="200" height="55" as="geometry" /></mxCell><mxCell id="gc-lbl-lic-yes" value="Yes" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontStyle=1;fontSize=12;labelBackgroundColor=#ffffff;" parent="OZ9AxooTVeGa2e1UKhC_-1" vertex="1"><mxGeometry x="662" y="1362" width="40" height="20" as="geometry" /></mxCell><mxCell id="gc-q-vmware" value="&lt;b&gt;VMware estate needing preserved hypervisor / tooling or rapid bulk exit?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" parent="OZ9AxooTVeGa2e1UKhC_-1" vertex="1"><mxGeometry x="737" y="2470" width="140" height="150" as="geometry" /></mxCell><mxCell id="gc-e-vmware-rehost" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=0;jumpStyle=arc;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;fontStyle=1;fontSize=13;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="OZ9AxooTVeGa2e1UKhC_-1" edge="1" source="gc-q-vmware" target="7ZSVmvyxEU6zFuQFi4_P-17"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="gc-relocate" value="&lt;b&gt;&lt;font style=&quot;font-size: 15px&quot;&gt;RELOCATE&lt;/font&gt;&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeWidth=2;strokeColor=#D6B656;" parent="OZ9AxooTVeGa2e1UKhC_-1" vertex="1"><mxGeometry x="1030" y="2680.0" width="157.0" height="60.0" as="geometry" /></mxCell><mxCell id="gc-e-vmware-relocate" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;jumpStyle=arc;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;fontStyle=1;fontSize=13;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="OZ9AxooTVeGa2e1UKhC_-1" edge="1" source="gc-q-vmware" target="gc-relocate"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1108.5" y="2545" /></Array></mxGeometry></mxCell><mxCell id="gc-rel-tick1" value="" style="endArrow=oval;html=1;strokeWidth=1;endFill=1;" parent="OZ9AxooTVeGa2e1UKhC_-1" edge="1">
