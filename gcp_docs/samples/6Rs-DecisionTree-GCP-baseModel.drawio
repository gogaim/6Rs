  <diagram name="Glossary and Information" id="o2KeoDBUj4RmtOQ3cjDU">
    <mxGraphModel dx="1626" dy="878" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="DoUkRrNKk3-1lUpl4Vq--0" />
        <mxCell id="DoUkRrNKk3-1lUpl4Vq--1" parent="DoUkRrNKk3-1lUpl4Vq--0" />
        <mxCell id="DoUkRrNKk3-1lUpl4Vq--2" value="&lt;h1&gt;Terminology used&lt;/h1&gt;&lt;p&gt;&lt;b&gt;Application:&lt;/b&gt; a program, database, module, service, package, etc., including supporting infrastructure.&lt;/p&gt;&lt;p&gt;&lt;b&gt;Migration/Modernization Strategy:&lt;/b&gt; a high-level description of the approach to treat, move, or modernize the application or component (for example, Rehost or Relocate).&lt;/p&gt;&lt;p&gt;&lt;b&gt;TIME:&lt;/b&gt; Gartner Tolerate / Invest / Migrate / Eliminate disposition model (Stage 1 pre-filter).&lt;/p&gt;&lt;p&gt;&lt;b&gt;M2VM:&lt;/b&gt; Migrate to Virtual Machines &amp;nbsp;&lt;b&gt;M2C:&lt;/b&gt; Migrate to Containers &amp;nbsp;&lt;b&gt;GCVE:&lt;/b&gt; Google Cloud VMware Engine &amp;nbsp;&lt;b&gt;GCE:&lt;/b&gt; Google Compute Engine&lt;/p&gt;&lt;p&gt;&lt;b&gt;DMS / DMA:&lt;/b&gt; Database Migration Service / Database Migration Assessment&lt;/p&gt;&lt;p&gt;&lt;b&gt;EOL / EOSL:&lt;/b&gt; End Of Life / End Of Service Life &amp;nbsp;&lt;b&gt;COTS:&lt;/b&gt; Commercial Off-The-Shelf product &amp;nbsp;&lt;b&gt;SaaS:&lt;/b&gt; Software as a Service product &amp;nbsp;&lt;b&gt;N/A:&lt;/b&gt; Not Applicable&lt;/p&gt;&lt;h1&gt;Stage 1 – Strategic disposition&lt;/h1&gt;&lt;p&gt;&lt;b&gt;Eliminate:&lt;/b&gt; low business value + low technical health, or redundant capability → Retire / consolidate.&lt;/p&gt;&lt;p&gt;&lt;b&gt;Tolerate:&lt;/b&gt; low/medium business value + high technical health, no hard data-center exit → Retain and optimize in place.&lt;/p&gt;&lt;p&gt;&lt;b&gt;Migrate / Invest:&lt;/b&gt; high business value, technical debt, or a hard data-center exit deadline → Stage 2 decision tree.&lt;/p&gt;&lt;h1&gt;Stage 2 – Strategy definitions (7 Rs)&lt;/h1&gt;&lt;p&gt;&lt;b&gt;Retire:&lt;/b&gt; decommission the application (or consolidate it) without migrating or modernizing.&lt;/p&gt;&lt;p&gt;&lt;b&gt;Retain:&lt;/b&gt; keep running the application in its current location (on premises, hybrid, or Google Distributed Cloud).&lt;/p&gt;&lt;p&gt;&lt;b&gt;Rehost:&lt;/b&gt; rapid lift-and-shift of servers to Compute Engine (via M2VM) without architectural, technology, or functionality changes.&lt;/p&gt;&lt;p&gt;&lt;b&gt;Relocate:&lt;/b&gt; move VMware workloads to Google Cloud VMware Engine (via VMware HCX) without hypervisor or guest OS changes.&lt;/p&gt;&lt;p&gt;&lt;b&gt;Repurchase:&lt;/b&gt; purchase, configure, or customize a COTS or SaaS product (for example, through Google Cloud Marketplace).&lt;/p&gt;&lt;p&gt;&lt;b&gt;Replatform:&lt;/b&gt; enhance or upgrade underlying components such as the operating system, runtime, containers, or managed databases.&lt;/p&gt;&lt;p&gt;&lt;b&gt;Refactor / Re-architect:&lt;/b&gt; modernize by applying substantial changes to the code base and/or architecture (for example, containers, serverless, cloud-native data).&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" parent="DoUkRrNKk3-1lUpl4Vq--1" vertex="1">
          <mxGeometry x="80" y="60" width="760" height="1060" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>